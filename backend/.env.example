APP_NAME=Vynce
APP_VERSION=1.0.0
DEBUG=false

DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=COLOQUE_AQUI_UMA_CHAVE_ALEATORIA_FORTE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=vynce-api
JWT_AUDIENCE=vynce-web

FRONTEND_URL=https://SEU-FRONTEND.com
BACKEND_PUBLIC_URL=https://SEU-BACKEND.com
ALLOWED_ORIGINS=https://SEU-FRONTEND.com
# Opcional. Ex.: vincy-backend-u43m.onrender.com
ALLOWED_HOSTS=
CREDENTIAL_ENCRYPTION_KEY=

REQUIRE_EMAIL_VERIFICATION=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

MAX_REQUEST_BODY_BYTES=1048576
API_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_15_MINUTES=30
PASSWORD_RECOVERY_LIMIT_PER_15_MINUTES=5
CAMPAIGN_RATE_LIMIT_PER_MINUTE=10
MAX_CAMPAIGN_RECIPIENTS=500
CAMPAIGN_DAILY_RECIPIENT_LIMIT=2000
EVOLUTION_ALLOW_PRIVATE_TARGETS=false

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_TOLERANCE_SECONDS=300

